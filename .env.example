# ----- Public (exposed to the browser; safe to commit) -----
# Origin used for canonical URLs, OG tags, sitemap, JSON-LD.
# On Vercel, set this to your live URL (e.g. https://your-app.vercel.app or your custom domain).
VITE_SITE_URL=https://mayank-garg.vercel.app

# ----- Server-only (used by /api/contact, NEVER exposed to the browser) -----
# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# Inbox that should receive contact-form submissions.
# IMPORTANT: on Resend's free tier *without a verified domain*, this MUST be the
# email you signed up to Resend with — sandbox sends are restricted to your own
# verified address. (For a contact form going to your own inbox, that's perfect.)
CONTACT_TO_EMAIL=

# Optional — sender address. Leave unset to use Resend's sandbox sender
# (`onboarding@resend.dev`) which works without owning a domain.
# After you verify a domain in Resend, set this to e.g. `contact@yourdomain.com`.
CONTACT_FROM_EMAIL=
CONTACT_FROM_NAME=Portfolio Contact

# Optional — restrict the API to one origin (e.g. https://mayank-garg.vercel.app).
# Leave empty during local dev.
ALLOWED_ORIGIN=
